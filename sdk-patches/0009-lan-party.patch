+uint32_t WritePartyList(uint8_t* list) {
+  Start();
+  std::memset(list, 0, 8 + kMaxPartyMembers * kPartyEntrySize);
+  std::lock_guard lock(g_mutex);
+  // Everyone sees the same order: by XUID.
+  std::map<uint64_t, const Member*> ordered;
+  Member self;
+  const std::string name = system_link::PlayerName();
+  std::memcpy(self.gamertag.data(), name.data(), std::min<size_t>(name.size(), kGamertagSize - 1));
+  self.custom = g_custom;
+  self.hosting = g_hosted_object != 0;
+  if (self.hosting) self.session = g_hosted.info;
+  const uint64_t self_xuid = system_link::PlayerXuid();
+  ordered[self_xuid] = &self;
+  for (const auto& [xuid, member] : g_members) {
+    if (InParty(member)) ordered[xuid] = &member;
+  }
+  const uint32_t title_id = REX_KERNEL_STATE() ? REX_KERNEL_STATE()->title_id() : 0;
+  uint32_t count = 0;
+  for (const auto& [xuid, member] : ordered) {
+    if (count == kMaxPartyMembers) break;
+    // XPARTY_USER_INFO: XUID, gamertag, user index, NAT type, title id,
+    // flags, XSESSION_INFO, 4 bytes padding, XPARTY_CUSTOM_DATA.
+    uint8_t* entry = list + 8 + count * kPartyEntrySize;
+    const bool local = xuid == self_xuid;
+    Store64(entry, xuid);
+    std::memcpy(entry + 8, member->gamertag.data(), kGamertagSize);
+    Store32(entry + 24, local ? 0 : 0xFFFFFFFF);
+    Store32(entry + 28, kNatOpen);
+    Store32(entry + 32, title_id);
+    Store32(entry + 36, (local ? kPartyUserIsLocal : 0) |
+                            (member->hosting ? kPartyUserInSession : 0));
+    if (member->hosting) std::memcpy(entry + 40, member->session.data(), kInfoSize);
+    std::memcpy(entry + 104, member->custom.data(), kCustomDataSize);
+    ++count;
+  }
+  Store32(list, count);
+  return count;
+}
