+void SendPartyInvites() {
+  Start();
+  std::lock_guard lock(g_mutex);
+  if (!g_hosted_object) {
+    if (system_link::Logging()) REXSYS_INFO("lan party: invites without a hosted session");
+    return;
+  }
+  g_party_host = true;
+  g_inviting = true;
+  g_challenger = PickChallenger();
