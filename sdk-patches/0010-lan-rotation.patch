 // there's none.
 bool AcceptedInvite(uint8_t* info);
 
+// Winner stays: the title reports each match's end and the SDK moves the
+// party's host role to the winner. Each console announces the number of the
+// last match it fought in; the next challenger is the invitable member who
+// fought longest ago.
+
+// What this console does after a party match.
+enum class PartyRole {
+  kNone,        // not a party match
+  kHost,        // the host won: it keeps hosting (back to its lobby)
+  kStepDown,    // the host lost: it stops hosting and queues with the others
+  kBecomeHost,  // the opponent won: its next lobby invites the party
+  kRejoin,      // the opponent lost: back to the menu, to queue
+  kWatch,       // an observer
+};
+// The match this console was in ended: `local_side` 0 = the session's host, 1
+// = the opponent, other = an observer; `winner_side` the side that won (pass
+// 0 to keep the host fighting). Call once per match.
+PartyRole PartyMatchOver(int local_side, int winner_side);
+// The title's party rules (kPartyRulesSize opaque bytes: whatever a new host
+// needs to set up the same lobby), announced with this console's player.
+constexpr uint32_t kPartyRulesSize = 4;
+void SetPartyRules(const uint8_t* rules);
+// The rules announced by the host whose invite this console last took. False
+// if that host isn't heard any more.
+bool LastHostRules(uint8_t* rules);
+
 }  // namespace rex::system::lan_sessions
