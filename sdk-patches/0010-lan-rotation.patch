+PartyRole PartyMatchOver(int local_side, int winner_side) {
+  std::lock_guard lock(g_mutex);
+  // A party match: this console hosted the party, or took a party invite to
+  // the session it is in.
+  const bool party = g_party_host || (g_invited_to && g_joined == g_invited_to);
+  if (!party) return PartyRole::kNone;
+  if (local_side != 0 && local_side != 1) return PartyRole::kWatch;
+  uint32_t highest = g_last_match;
+  for (const auto& [xuid, member] : g_members) highest = std::max(highest, member.last_match);
+  g_last_match = highest + 1;
+  PartyRole role;
+  if (local_side == 0) {
+    role = winner_side == 0 ? PartyRole::kHost : PartyRole::kStepDown;
+  } else {
+    role = winner_side == 1 ? PartyRole::kBecomeHost : PartyRole::kRejoin;
+  }
+  if (role == PartyRole::kStepDown) {
+    g_party_host = false;
+    g_inviting = false;
+    g_step_down = StepDown::kBeforeLobby;
+  } else if (role == PartyRole::kBecomeHost) {
+    // Its next lobby invites the party (HostCreated), whoever it came from.
+    g_party_host = true;
+    g_left_lobby = false;
+    g_inviting = false;
+  }
+  SendToLan(MemberPacket());
+  g_last_member_announce = Clock::now();
+  if (system_link::Logging()) {
+    static const char* const kNames[] = {"none", "keeps hosting", "steps down", "becomes the host",
+                                         "queues again", "watched"};
+    REXSYS_INFO("lan party: match {} over, side {} won; this console (side {}) {}", g_last_match,
+                winner_side + 1, local_side + 1, kNames[int(role)]);
+  }
+  return role;
+}
+
+void SetPartyRules(const uint8_t* rules) {
+  if (!rules) return;
+  std::lock_guard lock(g_mutex);
+  if (std::memcmp(g_rules.data(), rules, kPartyRulesSize) == 0) return;
+  std::memcpy(g_rules.data(), rules, kPartyRulesSize);
+  SendToLan(MemberPacket());
+  g_last_member_announce = Clock::now();
+}
+
+bool LastHostRules(uint8_t* rules) {
+  std::lock_guard lock(g_mutex);
+  const auto it = g_members.find(g_last_host);
+  if (!rules || it == g_members.end()) return false;
+  std::memcpy(rules, it->second.rules.data(), kPartyRulesSize);
+  return true;
+}
+
 }  // namespace rex::system::lan_sessions
